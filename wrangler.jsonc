// Worker do cardápio: serve o site e os links curtos para o entregador.
{
  "name": "pasteldojuca",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pasteldojuca-entregas", "database_id": "820633ac-2451-4ca9-b956-6d41166660af" }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "kv_namespaces": [
    { "binding": "ENTREGAS", "id": "ac2dbcac92304f4b9e092874be157ccd" }
  ],
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
